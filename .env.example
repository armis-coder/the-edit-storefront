# Catalogue preview works with no configuration. To operate the real store:
COMMERCE_PROVIDER=independent
DATABASE_URL=
SITE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Optional transactional email (a verified sender is required)
RESEND_API_KEY=
STORE_EMAIL_FROM=
STORE_ORDER_EMAIL=
# Local development only. Never configure this on Vercel.
# STORE_DEVELOPMENT_DB=.store-db

# Non-Vercel hosts: only set to an IP header your trusted reverse proxy overwrites.
# STORE_TRUSTED_IP_HEADER=
