{
  "name": "curated-mens-gear",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:commerce && npm run build && node scripts/verify-next.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "build:vercel": "next build",
    "dev:vercel": "next dev",
    "start:vercel": "next start",
    "test:commerce": "NODE_ENV=test node --import tsx --test tests/store-system.test.ts",
    "store:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/store-migrate.ts",
    "store:demo": "node --env-file-if-exists=.env.local --import tsx scripts/store-demo.ts",
    "store:credentials": "node scripts/store-credentials.mjs",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build:sites": "bash scripts/build-verified.sh",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:sites": "npm run build:sites && node --test tests/rendered-html.test.mjs",
    "test:http": "node scripts/verify-store.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5",
    "three": "^0.185.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "The Curated Goods Storefront"
}
